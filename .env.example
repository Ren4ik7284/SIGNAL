# Секретный ключ для подписи внутренних JWT-токенов (сгенерируйте случайную строку)
JWT_SECRET=super_secret_jwt_random_key_replace_in_prod

# Google OAuth 2.0 Client ID (полученный в Google Cloud Console -> APIs & Services -> Credentials)
# Пример: 123456789012-abcdefghijklmnopqrstuvwxyz123456.apps.googleusercontent.com
GOOGLE_CLIENT_ID=

# Разрешенные CORS origins (через запятую)
# ALLOWED_ORIGINS=http://localhost:4200,https://signal-frontend-production-a944.up.railway.app
